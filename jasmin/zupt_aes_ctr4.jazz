/* ZUPT — AES-256-CTR four-block pipeline
 * Copyright (c) 2026 Cristian Cezar Moisés
 * SPDX-License-Identifier: AGPL-3.0-or-later
 *
 * Key expansion follows the implementation in zupt_aes_ctr.jazz.
 * The upper eight counter bytes stay fixed; the lower eight bytes are a
 * big-endian u64 advanced modulo 2^64. All data accesses are unaligned.
 * The input and output slices may be identical or disjoint, but not partly
 * overlapping. The key and counter must be separate from the output slice.
 * A zero block count does not access any caller-provided memory.
 */

inline fn ctr4_key_expand_even(reg u128 t0, reg u128 assist) -> reg u128 {
    reg u128 tmp;
    assist = #VPSHUFD(assist, 0xFF);
    tmp = #VPSLLDQ(t0, 4);
    t0 ^= tmp;
    tmp = #VPSLLDQ(t0, 4);
    t0 ^= tmp;
    tmp = #VPSLLDQ(t0, 4);
    t0 ^= tmp;
    t0 ^= assist;
    return t0;
}

inline fn ctr4_key_expand_odd(reg u128 t0, reg u128 t1) -> reg u128 {
    reg u128 tmp assist;
    assist = #VAESKEYGENASSIST(t0, 0);
    assist = #VPSHUFD(assist, 0xAA);
    tmp = #VPSLLDQ(t1, 4);
    t1 ^= tmp;
    tmp = #VPSLLDQ(t1, 4);
    t1 ^= tmp;
    tmp = #VPSLLDQ(t1, 4);
    t1 ^= tmp;
    t1 ^= assist;
    return t1;
}

#[ct = "public * public * public * public * public -> ()",
  stackzero = "unrolled", stackzerosize = u128]
export fn zupt_aes256_ctr4(
    reg u64 out_ptr,
    reg u64 in_ptr,
    reg u64 key_ptr,
    reg u64 ctr_ptr,
    reg u64 nblocks)
{
    stack u128[15] roundkeys;
    stack u64[2] counter;
    reg u128 t0 t1 assist b0 b1 b2 b3 data0 data1 data2 data3;
    reg u64 counter_value counter_be;
    inline int round;

    if (nblocks != 0) {
        t0 = [:u128 key_ptr + 0];
        t1 = [:u128 key_ptr + 16];
        roundkeys[0] = t0;
        roundkeys[1] = t1;

        assist = #VAESKEYGENASSIST(t1, 0x01);
        t0 = ctr4_key_expand_even(t0, assist);
        roundkeys[2] = t0;
        t1 = ctr4_key_expand_odd(t0, t1);
        roundkeys[3] = t1;

        assist = #VAESKEYGENASSIST(t1, 0x02);
        t0 = ctr4_key_expand_even(t0, assist);
        roundkeys[4] = t0;
        t1 = ctr4_key_expand_odd(t0, t1);
        roundkeys[5] = t1;

        assist = #VAESKEYGENASSIST(t1, 0x04);
        t0 = ctr4_key_expand_even(t0, assist);
        roundkeys[6] = t0;
        t1 = ctr4_key_expand_odd(t0, t1);
        roundkeys[7] = t1;

        assist = #VAESKEYGENASSIST(t1, 0x08);
        t0 = ctr4_key_expand_even(t0, assist);
        roundkeys[8] = t0;
        t1 = ctr4_key_expand_odd(t0, t1);
        roundkeys[9] = t1;

        assist = #VAESKEYGENASSIST(t1, 0x10);
        t0 = ctr4_key_expand_even(t0, assist);
        roundkeys[10] = t0;
        t1 = ctr4_key_expand_odd(t0, t1);
        roundkeys[11] = t1;

        assist = #VAESKEYGENASSIST(t1, 0x20);
        t0 = ctr4_key_expand_even(t0, assist);
        roundkeys[12] = t0;
        t1 = ctr4_key_expand_odd(t0, t1);
        roundkeys[13] = t1;

        assist = #VAESKEYGENASSIST(t1, 0x40);
        t0 = ctr4_key_expand_even(t0, assist);
        roundkeys[14] = t0;

        counter[0] = [:u64 ctr_ptr + 0];
        counter_be = [:u64 ctr_ptr + 8];
        counter[1] = counter_be;
        counter_value = counter_be;
        counter_value = #BSWAP(counter_value);

        #[ensure_termination]
        while (nblocks >= 4) {
            b0 = counter.[:u128 0];
            counter_value += 1;
            counter_be = counter_value;
            counter_be = #BSWAP(counter_be);
            counter[1] = counter_be;
            b1 = counter.[:u128 0];
            counter_value += 1;
            counter_be = counter_value;
            counter_be = #BSWAP(counter_be);
            counter[1] = counter_be;
            b2 = counter.[:u128 0];
            counter_value += 1;
            counter_be = counter_value;
            counter_be = #BSWAP(counter_be);
            counter[1] = counter_be;
            b3 = counter.[:u128 0];
            counter_value += 1;
            counter_be = counter_value;
            counter_be = #BSWAP(counter_be);
            counter[1] = counter_be;

            b0 ^= roundkeys[0];
            b1 ^= roundkeys[0];
            b2 ^= roundkeys[0];
            b3 ^= roundkeys[0];
            for round = 1 to 14 {
                b0 = #VAESENC(b0, roundkeys[round]);
                b1 = #VAESENC(b1, roundkeys[round]);
                b2 = #VAESENC(b2, roundkeys[round]);
                b3 = #VAESENC(b3, roundkeys[round]);
            }
            b0 = #VAESENCLAST(b0, roundkeys[14]);
            b1 = #VAESENCLAST(b1, roundkeys[14]);
            b2 = #VAESENCLAST(b2, roundkeys[14]);
            b3 = #VAESENCLAST(b3, roundkeys[14]);

            data0 = [:u128 in_ptr + 0];
            data1 = [:u128 in_ptr + 16];
            data2 = [:u128 in_ptr + 32];
            data3 = [:u128 in_ptr + 48];
            b0 ^= data0;
            b1 ^= data1;
            b2 ^= data2;
            b3 ^= data3;
            [:u128 out_ptr + 0] = b0;
            [:u128 out_ptr + 16] = b1;
            [:u128 out_ptr + 32] = b2;
            [:u128 out_ptr + 48] = b3;
            in_ptr += 64;
            out_ptr += 64;
            nblocks -= 4;
        }

        #[ensure_termination]
        while (nblocks != 0) {
            b0 = counter.[:u128 0];
            b0 ^= roundkeys[0];
            for round = 1 to 14 {
                b0 = #VAESENC(b0, roundkeys[round]);
            }
            b0 = #VAESENCLAST(b0, roundkeys[14]);
            data0 = [:u128 in_ptr + 0];
            b0 ^= data0;
            [:u128 out_ptr + 0] = b0;

            counter_value += 1;
            counter_be = counter_value;
            counter_be = #BSWAP(counter_be);
            counter[1] = counter_be;
            in_ptr += 16;
            out_ptr += 16;
            nblocks -= 1;
        }

        b0 = counter.[:u128 0];
        [:u128 ctr_ptr + 0] = b0;
    }
}
